# Copy to backend/.env for local development.
#
# 127.0.0.1 rather than localhost: docker-compose publishes Postgres on IPv4
# loopback only, and localhost can resolve to ::1 first.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/portfolio?schema=public"
PORT=4000
NODE_ENV=development

# Optional. Bind to loopback so the API is reachable only through Nginx.
# HOST=127.0.0.1

# Optional. Extra browser origins allowed to call the API (comma-separated).
# Same-origin needs none; the default is https://manugahewa.dev.
# CORS_ORIGINS=

# Optional. Switches on Cloudflare Turnstile verification for the contact
# form; the frontend also needs VITE_TURNSTILE_SITE_KEY at build time.
# TURNSTILE_SECRET_KEY=
